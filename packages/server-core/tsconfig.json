{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@infrapilot/contracts": ["../contracts/src/index.ts"],
      "@infrapilot/database": ["../database/src/index.ts"],
      "@/db/*": ["../database/src/*"],
      "@/lib/*": ["src/lib/*"],
      "@/services/*": ["src/services/*"],
      "@/validators/*": ["../contracts/src/validators/*"]
    }
  },
  "include": ["src/**/*.ts", "../contracts/src/**/*.ts", "../database/src/**/*.ts"]
}
