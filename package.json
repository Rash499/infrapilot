{
  "name": "infrapilot",
  "private": true,
  "workspaces": [
    "apps/frontend",
    "apps/backend",
    "apps/worker",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/frontend",
    "dev:frontend": "npm run dev -w apps/frontend",
    "dev:backend": "npm run dev -w apps/backend",
    "dev:worker": "npm run dev -w apps/worker",
    "build": "npm run build -w apps/frontend",
    "build:frontend": "npm run build -w apps/frontend",
    "build:backend": "npm run build -w apps/backend",
    "lint": "npm run lint -w apps/frontend",
    "typecheck": "npm run typecheck -w apps/frontend && npm run typecheck -w apps/backend && npm run typecheck -w apps/worker",
    "test": "vitest run --config apps/frontend/vitest.config.ts",
    "test:e2e": "npm run test:e2e -w apps/frontend",
    "db:init:mongo": "tsx src/db/init.ts",
    "db:seed:mongo": "tsx src/db/seed-mongodb.ts",
    "db:check:mongo": "tsx scripts/check-mongodb.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.7",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "axios": "^1.21.1",
    "dotenv": "17.3.1",
    "jose": "^6.2.18",
    "jsdom": "^31.0.1",
    "lucide-react": "^1.77.0",
    "mongodb": "^6.21.0",
    "next": "^16.4.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.92.0",
    "recharts": "^3.11.0",
    "tsx": "^4.23.15",
    "vitest": "^5.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-orm": "0.45.2",
    "pg": "8.20.0",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.4.6",
    "postcss": "8.5.23",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  }
}
