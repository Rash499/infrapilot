# Copy to .env and replace every placeholder. Never commit .env.

# --- MongoDB (application database) ---
# Generate passwords with `openssl rand -hex 32`; make a one-line replica key with
# `openssl rand -base64 756 | tr -d '\n'`.
MONGO_ROOT_USER=infrapilot_root
MONGO_ROOT_PASSWORD=replace-with-hex-generated-root-password
MONGO_APP_USER=infrapilot_user
MONGO_APP_PASSWORD=replace-with-hex-generated-app-password
MONGO_REPLICA_KEY=replace-with-base64-generated-replica-key
MONGODB_URI=mongodb://infrapilot_user:replace-with-hex-generated-app-password@127.0.0.1:27017/infrapilot?authSource=infrapilot&replicaSet=rs0
MONGODB_DB=infrapilot
# Set DATABASE_URL only when importing an existing PostgreSQL database with scripts/migrate-data.ts.
# DATABASE_URL=postgresql://user:password@localhost:5432/infrapilot

# --- Authentication ---
# Generate with: openssl rand -base64 48   (minimum 32 characters)
JWT_ACCESS_SECRET=replace-with-output-of-openssl-rand-base64-48
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
PASSWORD_RESET_TTL_MINUTES=30
# true only for local development: returns the reset token in the API response instead of mail delivery
EXPOSE_RESET_TOKEN=false

# --- Application ---
APP_ORIGIN=http://localhost:3000
APP_PORT=3000
# Set true only behind a trusted reverse proxy that overwrites X-Forwarded-For
TRUST_PROXY_HEADERS=false
LOG_LEVEL=info

# --- Monitoring worker ---
INFRAPILOT_EMBEDDED_WORKER=true
MONITOR_TICK_MS=5000
MONITOR_BATCH_SIZE=25
MONITOR_MAX_CONCURRENCY=5
MONITOR_FAILURE_THRESHOLD=3
MONITOR_RETENTION_DAYS=30

# --- Change management ---
REQUIRED_CHANGE_APPROVALS=1

# --- Development seed (optional) ---
# SEED_PASSWORD=choose-a-strong-dev-password