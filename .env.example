# Copy to .env and replace every placeholder. Never commit .env.

# --- MongoDB (target datastore for the MongoDB migration) ---
# Local MongoDB 8.x single-node replica set. Use the least-privilege InfraPilot DB user.
# The infrapilot_user account is created in the infrapilot database, so authSource must match.
MONGODB_URI=mongodb://infrapilot_user:change-me-strong-password@127.0.0.1:27017/infrapilot?authSource=infrapilot&replicaSet=rs0
MONGODB_DB=infrapilot

# --- PostgreSQL (temporary compatibility setting during the staged migration) ---
# Removed after all service and worker modules have been migrated to MongoDB.
DATABASE_URL=postgresql://postgres:change-me-strong-password@127.0.0.1:5432/app_db

# --- Authentication ---
# Generate with: openssl rand -base64 48   (minimum 32 characters)
JWT_ACCESS_SECRET=replace-with-output-of-openssl-rand-base64-48
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
PASSWORD_RESET_TTL_MINUTES=30
# true only for local development: returns the reset token in the API response instead of mail delivery
EXPOSE_RESET_TOKEN=false

# --- Application ---
APP_ORIGIN=http://localhost:3000
APP_PORT=3000
# Set true only behind a trusted reverse proxy that overwrites X-Forwarded-For
TRUST_PROXY_HEADERS=false
LOG_LEVEL=info

# --- Monitoring worker ---
INFRAPILOT_EMBEDDED_WORKER=true
MONITOR_TICK_MS=5000
MONITOR_BATCH_SIZE=25
MONITOR_MAX_CONCURRENCY=5
MONITOR_FAILURE_THRESHOLD=3
MONITOR_RETENTION_DAYS=30

# --- Change management ---
REQUIRED_CHANGE_APPROVALS=1

# --- Development seed (optional) ---
# SEED_PASSWORD=choose-a-strong-dev-password