{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "types": ["node"],
    "paths": {
      "@infrapilot/contracts": ["../../packages/contracts/src/index.ts"],
      "@infrapilot/database": ["../../packages/database/src/index.ts"],
      "@infrapilot/server-core": ["../../packages/server-core/src/index.ts"],
      "@infrapilot/server-core/load-env": ["../../packages/server-core/src/load-env.ts"],
      "@/services/*": ["../../packages/server-core/src/services/*"],
      "@/lib/*": ["../../packages/server-core/src/lib/*"],
      "@/db/*": ["../../packages/database/src/*"],
      "@/validators/*": ["../../packages/contracts/src/validators/*"],
      "@/workers/*": ["src/*"],
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*.ts", "../../packages/**/*.ts"]
}
